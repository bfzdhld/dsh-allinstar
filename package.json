{
  "name": "dsh-allinstar",
  "version": "1.0.0",
  "description": "Star the GitHub repositories behind your installed plugins without leaving DeepSeek Harness.",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "stars"
  ],
  "author": "bfzdhld",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bfzdhld/dsh-allinstar.git"
  },
  "bugs": {
    "url": "https://github.com/bfzdhld/dsh-allinstar/issues"
  },
  "homepage": "https://github.com/bfzdhld/dsh-allinstar#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale"]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1"
  },
  "license": "MIT"
}
